rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }

    match /users/{uid} {
      allow create: if owner(uid) && request.resource.data.role == 'user';
      allow read: if owner(uid) || admin();
      allow update: if owner(uid) && request.resource.data.role == resource.data.role;
      allow delete: if admin();
    }
    match /books/{bookId} {
      allow read: if true;
      allow create, delete: if admin();
      allow update: if admin() || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount', 'updatedAt']));
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || admin());
    }
  }
}